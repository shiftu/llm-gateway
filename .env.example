# LLM Gateway — Docker Environment
# Copy this file to .env and fill in your values before running docker-compose.

# Gateway bearer token (required)
LLM_GATEWAY_TOKEN=change-me-to-a-random-string

# Master key for encrypting provider API keys at rest (required)
# Generate with: openssl rand -base64 32
LLM_GATEWAY_MASTER_KEY=change-me-to-a-random-key

# Optional: seed a DeepSeek provider on first start
# LLM_GATEWAY_PROVIDER_KIND=deepseek
# LLM_GATEWAY_PROVIDER_API_KEY=sk-your-deepseek-key

# Optional: enable Prometheus /metrics endpoint
# LLM_GATEWAY_ENABLE_METRICS=1
